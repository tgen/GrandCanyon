{% macro copy_ubam(ubam) %}

- name: copy_ubams_{{ ubam.basename | replace(".", "_") }}
  input: {{ ubam.path }}
  output:
    - temp/ubams/{{ ubam.basename }}
  retry: 2
  cpus: 6
  walltime: "4:00:00"
  queue_preset: "DATA-MOVER"
  cmd: |
    set -uev

    mkdir -p temp/ubams/

    rsync {{ ubam.path }} temp/ubams/

{% if ubam.glPrep.lower().startswith('kinnex') %}
- name: pbindex_ubam_{{ ubam.basename | replace(".", "_") }}
  reset: predecessors
  input:
    - temp/ubams/{{ ubam.basename }}
  output:
    - temp/ubams/{{ ubam.basename }}.pbi
  cpus: 2
  mem: 8G
  walltime: "4:00:00"
  queue_preset: "DEFAULT"
  container: {{ constants.tools.pbtk.container }}
  cmd: |
    set -e

    pbindex temp/ubams/{{ ubam.basename }}

{% endif %}

- name: convert_ubam_to_fastq_{{ ubam.basename | replace(".", "_") }}
  reset: predecessors
  input:
    - temp/ubams/{{ ubam.basename }}
  output:
    {% if ubam.glPrep|lower not in ['longread'] and not ubam.glPrep.lower().startswith('kinnex') %}
    - temp/fastqs/{{ ubam.basename | replace(".", "_") }}_R1.fastq.gz
    - temp/fastqs/{{ ubam.basename | replace(".", "_") }}_R2.fastq.gz
    {% else %}
    - temp/fastqs/{{ ubam.basename | replace(".", "_") }}.fastq.gz
    {% if ubam.fastqCode == 'duplex' %}
    - temp/fastqs/{{ ubam.basename | replace(".", "_") }}.simplex.fastq.gz
    {% endif %}
    {% endif %}
  cpus: 6
  mem: 40G
  walltime: "4:00:00"
  queue_preset: "DEFAULT"
  container: {{ constants.tools.samtools.container }}
  cmd: |
    set -uev

    mkdir -p temp/fastqs/

    {% if ubam.glPrep|lower not in ['longread'] and not ubam.glPrep.lower().startswith('kinnex') %}
    samtools collate \
      --threads 6 \
      -u \
      -O \
      -T temp/fastqs/collate_{{ ubam.basename | replace(".", "_") }} \
      temp/ubams/{{ ubam.basename }} | \
    samtools fastq \
      --threads 6 \
      -1 temp/fastqs/{{ ubam.basename | replace(".", "_") }}_R1.fastq.gz \
      -2 temp/fastqs/{{ ubam.basename | replace(".", "_") }}_R2.fastq.gz \
      -0 /dev/null -s /dev/null -n
    {% elif ubam.fastqCode == 'duplex' %}
    {# long-read is not paired end, so we output to -0 #}
    samtools view \
      --threads 6 \
      -d dx:1 \
      {% if not allow_kinetics|default(false) %}
      -x 'fi,fn,fp,ri,rn,rp' \
      {% endif %}
      temp/ubams/{{ ubam.basename }} |\
    samtools fastq \
      --threads 6 \
      -T '*' \
      -0 temp/fastqs/{{ ubam.basename | replace(".", "_") }}.fastq.gz \
      -

    samtools view \
      --threads 6 \
      -d dx:0 \
      {% if not allow_kinetics|default(false) %}
      -x 'fi,fn,fp,ri,rn,rp' \
      {% endif %}
      temp/ubams/{{ ubam.basename }} |\
    samtools fastq \
      --threads 6 \
      -T '*' \
      -0 temp/fastqs/{{ ubam.basename | replace(".", "_") }}.simplex.fastq.gz \
      -
    {% else %}
    samtools view \
      --threads 6 \
      {% if not allow_kinetics|default(false) %}
      -x 'fi,fn,fp,ri,rn,rp' \
      {% endif %}
      temp/ubams/{{ ubam.basename }} |\
    samtools fastq \
      --threads 6 \
      -T '*' \
      -0 temp/fastqs/{{ ubam.basename | replace(".", "_") }}.fastq.gz \
      -
    {% endif %}

{% endmacro %}
