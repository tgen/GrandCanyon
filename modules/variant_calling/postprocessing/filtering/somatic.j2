{% macro filter_somatic_variants(sample_or_pair, input_vcf, temp_dir, results_dir, aligner, variant_caller) %}

{% if input_vcf.endswith('.vcf') %}
  {% set vcf_prefix = input_vcf.split('.')[:-1]|join('.') %}
{% elif input_vcf.endswith('.vcf.gz') %}
  {% set vcf_prefix = input_vcf.split('.')[:-2]|join('.') %}
{% else %}
  {{ raise('{} does not appear to be a vcf!'.format(input_vcf)) }}
{% endif %}

{% if sample_or_pair.normal is defined %}
  {%- set input_config = "paired" %}
{% else %}
  {% if sample_or_pair.subGroup|lower in ('tumor','tumour','case') %}
    {%- set input_config = "tumor_only" %}
  {% else %}
    {%- set input_config = "germline" %}
  {% endif %}
{% endif %}

{% if input_config in 'tumor_only' %}
  {% if task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter is not defined %}
    {% do task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].update({'variants_to_include_filter': []}) %}

    {# Checking if CC_filter is already defined, in preparation for allowing user defined filters #}
    {# This is not defined in the pipeline.yaml, since it is already dynamic, but we allow users to set the value #}
    {% if task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].CC_filter is not defined %}
      {% if variant_caller == 'merged' and sample_or_pair.callers is defined and sample_or_pair.callers|length > 1 %}
        {% if sample_or_pair.callers | length > 3 %}
          {% set CC_filter %}INFO/CC>={{ sample_or_pair.callers | length - 2 }}{% endset %}
        {% else %}
          {% set CC_filter %}INFO/CC>={{ sample_or_pair.callers | length - 1 }}{% endset %}
        {% endif %}
      {% endif %}
    {% else %}
      {% set CC_filter %}{{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].CC_filter }}{% endset %}
    {% endif %}
    {% if CC_filter is defined %}
      {% do task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter.append(CC_filter) %}
    {% endif %}

    {# This filter is partially dynamic, though more specifically it is very complex based on the number of annotation databases #}
    {% if task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].database_filter is not defined %}
      {# We expect this to already be defined from the pipeline.yaml #}
      {% if task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold is not number %}
        {{ raise('The supplied COSMIC_Ratio_Threshold: {} is not a number'.format(task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold)) }}
      {% elif task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold <= 0 or task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold >= 1 %}
        {{ raise('The supplied COSMIC_Ratio_Threshold: {} is outside of the expected range of 0..1'.format(task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold)) }}
      {% endif %}

      {# Ratios are capped in a range of 0-1, with 1 indicating an AC value of 0 #}
      {% set TOPMED_CNT_RATIO %}(INFO/COSMIC_CNT/(INFO/COSMIC_CNT + INFO/TOPMED_AC)>={{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold }}){% endset %}
      {% set TOPMED_NC_CNT_RATIO %}(INFO/COSMIC_NC_CNT/(INFO/COSMIC_NC_CNT + INFO/TOPMED_AC)>={{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold }}){% endset %}
      {% set GNOMAD_CNT_RATIO %}(INFO/COSMIC_CNT/(INFO/COSMIC_CNT + INFO/GNOMAD_AC)>={{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold }}){% endset %}
      {% set GNOMAD_NC_CNT_RATIO %}(INFO/COSMIC_NC_CNT/(INFO/COSMIC_NC_CNT + INFO/GNOMAD_AC)>={{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].COSMIC_Ratio_Threshold }}){% endset %}
      {% set INCLUDE_NON_DB %}(INFO/TOPMED==0 & INFO/GNOMAD=0){% endset %}
      {% set INCLUDE_FROM_RATIO %}({{ TOPMED_CNT_RATIO }} | {{ TOPMED_NC_CNT_RATIO }} | {{ GNOMAD_CNT_RATIO }} | {{ GNOMAD_NC_CNT_RATIO }}){% endset%}
      {% if variant_caller == 'merged' %}
        {% set DB_filter %} & ({{ INCLUDE_NON_DB }} | {{ INCLUDE_FROM_RATIO }}){% endset %}
      {% else %}
        {% set DB_filter %}({{ INCLUDE_NON_DB }} | {{ INCLUDE_FROM_RATIO }}){% endset %}
      {% endif %}
    {% else %}
      {% set DB_filter %}{{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].database_filter }}{% endset %}
    {% endif %}
    {% do task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter.append(DB_filter) %}
  {% endif %}

{% else %}

  {% if task_variables.somatic_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter is not defined %}
    {% do task_variables.somatic_variant_filtering[sample_or_pair.gltype|lower].update({'variants_to_include_filter': []}) %}

    {# Checking if CC_filter is already defined, in preparation for allowing user defined filters #}
    {# This is not defined in the pipeline.yaml, since it is already dynamic, but we allow users to set the value #}
    {% if task_variables.somatic_variant_filtering[sample_or_pair.gltype|lower].CC_filter is not defined %}
      {% if variant_caller == 'merged' and sample_or_pair.callers is defined and sample_or_pair.callers|length > 1 %}
        {% if sample_or_pair.callers | length > 3 %}
          {% set CC_filter %}INFO/CC>={{ sample_or_pair.callers | length - 2 }}{% endset %}
        {% else %}
          {% set CC_filter %}INFO/CC>={{ sample_or_pair.callers | length - 1 }}{% endset %}
        {% endif %}
      {% endif %}
    {% else %}
      {% set CC_filter = task_variables.somatic_variant_filtering[sample_or_pair.gltype|lower].CC_filter %}
    {% endif %}
    {% do task_variables.somatic_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter.append(CC_filter) %}
  {% endif %}

{% endif %}

{% set output_vcf %}{{ vcf_prefix }}.filtered.vcf.gz{% endset %}
{# Checking for output_vcf type, e.g. vcf.gz, vcf, bcf #}
{% if output_vcf.endswith('vcf') %}
  {% set output_type = 'v' %}
{% elif output_vcf.endswith('bcf') %}
  {% set output_type = 'b' %}
{% else %}
  {% set output_type = 'z' %}
{% endif %}

- name: variant_filtering_{{ sample_or_pair.name }}_{{ variant_caller }}_{{ aligner }}
  tags: [{{ sample_or_pair.gltype }}, somatic, variant_filter, {{ sample_or_pair.name }}]
  input: {{ input_vcf }}
  output: {{ output_vcf }}
  cpus: 1
  mem: 4G
  walltime: "4:00:00"
  queue_preset: "DEFAULT"
  container: {{ constants.tools.bcftools.container }}
  cmd: |
    set -eu
    set -o pipefail

    bcftools view \
      {% if input_config in 'tumor_only' %}
      --include '{{ task_variables.tumor_only_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter|join('') }}' \
      {% else %}
      --include "{{ task_variables.somatic_variant_filtering[sample_or_pair.gltype|lower].variants_to_include_filter|join('') }}" \
      {% endif %}
      --output-file {{ output_vcf }} \
      --output-type {{ output_type }} \
      {% if output_type != 'v' %}
      --write-index \
      {% endif %}
      {{ input_vcf }}

{% endmacro %}
