{% from 'modules/rna/minimap2.j2' import minimap2_rna with context %}
{% from 'modules/rna/star.j2' import star_quant with context %}
{% from 'modules/rna/fusion/ctat_lr.j2' import ctat_lr with context %}
{% from 'modules/rna/fusion/star_fusion.j2' import star_fusion with context %}
{% from 'modules/rna/isoform/isoseq.j2' import isoseq with context %}
{% from 'modules/rna/quantification/salmon_sr.j2' import salmon_sr with context %}
{% from 'modules/qc/main.j2' import bam_qc with context %}

{% macro rna_alignment(samples) %}

  {% for sample in samples.values() if sample.gltype in ['rna'] %}
    {% if sample.rgpm|lower in known_long_read_platforms %}
      {% if tasks['RNA_alignment_rna_alignment_minimap2']|default(false) %}
        {{- minimap2_rna(sample) }}
        {{- bam_qc(sample, aligner='minimap2') }}
      {% endif %}
      {% if sample.glprep.startswith('kinnex') %}
      {% if tasks['RNA_transcriptome_isoform_discovery_isoseq']|default(false) %}
        {{- isoseq(sample) }}
      {% endif %}
      {% endif %}
      {% if tasks['RNA_transcriptome_fusion_caller_STAR_Fusion']|default(false) %}
        {{- ctat_lr(sample) }}
      {% endif %}
    {% else %}
      {% set opt_dup_distance = 2500 %}
      {% if tasks['RNA_alignment_rna_alignment_STAR']|default(false) %}
        {{- star_quant(sample, opt_dup_distance) }}
        {{- bam_qc(sample, aligner='star') }}
      {% endif %}
      {% if tasks['RNA_transcriptome_fusion_caller_STAR_Fusion']|default(false) %}
        {{- star_fusion(sample) }}
      {% endif %}
      {% if tasks['RNA_transcriptome_quantify_expression_salmon']|default(false) %}
        {{- salmon_sr(sample) }}
      {% endif %}
    {% endif %}
  {% endfor %}

{% endmacro %}

